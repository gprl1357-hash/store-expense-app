# v2 스테이징 전용 — store-expense-app-v2
# 운영 Supabase 키를 넣지 마세요.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
NEXT_PUBLIC_MONTHLY_BUDGET=10000000

# dev Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 스테이징 기본: Slack 끔 (운영 채널 오발송 방지)
SLACK_ENABLED=false
# SLACK_BOT_TOKEN=
# SLACK_NOTIFY_CHANNEL_ID=
# SLACK_BACKUP_CHANNEL_ID=

CRON_SECRET=staging-dev-secret-change-me

# LAN 테스트 (선택)
# ALLOWED_DEV_ORIGINS=192.168.x.x
